@startuml c4-context-as-is
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

LAYOUT_WITH_LEGEND()

title Диаграмма контекста (C4, уровень 1) — As-Is: монолит «Тёплый дом»

Person(user, "Пользователь", "Владелец дома. Через веб-интерфейс включает/выключает отопление и смотрит текущую температуру.")
Person(technician, "Специалист по подключению", "Выезжает в дом, устанавливает модуль отопления и регистрирует его в системе.")

System(monolith, "Умный дом (монолит)", "Go + PostgreSQL. Хранит реестр датчиков/модулей, принимает команды пользователей, опрашивает датчики и отдаёт температуру.")

System_Ext(heating, "Модуль управления отоплением", "Установлен в каждом доме (~100 шт.). Реле отопления + датчик температуры. Принимает команды и отвечает на запросы сервера.")

Rel(user, monolith, "Управляет отоплением, просматривает температуру", "HTTPS / REST API")
Rel(technician, monolith, "Регистрирует новый модуль в доме", "HTTPS / REST API")
Rel(monolith, heating, "Отправляет команды вкл/выкл отопления", "HTTP (синхронно, сервер → датчик)")
Rel(monolith, heating, "Запрашивает текущую температуру (polling)", "HTTP (синхронно, сервер → датчик)")

SHOW_LEGEND()
@enduml
